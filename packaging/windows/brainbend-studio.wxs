<?xml version="1.0" encoding="UTF-8"?>
<!-- Built by scripts/package-windows.ps1 with WiX 5: wix build -arch x64|arm64 -d Version=0.3.1 -d Exe=... -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="BrainBend Studio" Manufacturer="BrainBend" Version="$(Version)" UpgradeCode="704C135C-8045-4617-BB65-98395A336D8D" Scope="perMachine" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of BrainBend Studio is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="app.ico" SourceFile="$(Icon)" />
    <Property Id="ARPPRODUCTICON" Value="app.ico" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="BrainBend Studio" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="MenuFolder" Name="BrainBend Studio" />
    </StandardDirectory>

    <ComponentGroup Id="App" Directory="INSTALLFOLDER">
      <Component Id="Exe">
        <File Id="StudioExe" Source="$(Exe)" Name="brainbend-studio.exe" KeyPath="yes" />
        <ProgId Id="BrainBend.Project" Description="BrainBend Studio project" Icon="app.ico">
          <Extension Id="brainbend" ContentType="application/x-brainbend">
            <Verb Id="open" Command="Open" Argument="&quot;%1&quot;" TargetFile="StudioExe" />
          </Extension>
        </ProgId>
        <ProgId Id="BrainBend.Story" Description="Course file" Icon="app.ico">
          <Extension Id="story" ContentType="application/x-brainbend-story">
            <Verb Id="open" Command="Open" Argument="&quot;%1&quot;" TargetFile="StudioExe" />
          </Extension>
        </ProgId>
      </Component>
      <Component Id="Licenses">
        <File Source="LICENSE-MIT" />
        <File Source="LICENSE-APACHE" />
        <File Source="THIRD-PARTY-LICENSES.md" />
        <File Source="FONT-LICENSES.md" />
      </Component>
    </ComponentGroup>

    <Component Id="Shortcut" Directory="MenuFolder">
      <Shortcut Id="StudioShortcut" Name="BrainBend Studio" Target="[INSTALLFOLDER]brainbend-studio.exe" WorkingDirectory="INSTALLFOLDER" Icon="app.ico" />
      <RemoveFolder Id="RemoveMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\BrainBend\Studio" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="BrainBend Studio" Level="1">
      <ComponentGroupRef Id="App" />
      <ComponentRef Id="Shortcut" />
    </Feature>
  </Package>
</Wix>
